[Unit]
Description=NUBO GOAPI backend
After=network-online.target
Wants=network-online.target
PartOf=nubo.target

[Service]
Type=simple
User=@NUBO_USER@
Group=@NUBO_GROUP@
WorkingDirectory=@NUBO_STATE_DIR@
Environment="NUBO_ENV_FILE=@NUBO_ENV_FILE@"
ExecStart=@NUBO_RELEASE_DIR@/bin/goapi
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=@NUBO_UPLOAD_DIR@

[Install]
WantedBy=nubo.target
