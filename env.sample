#
# NUBO 서버쪽 설정 파일
#

# 백엔드 서버
GOAPI_BASE=goapi
GOAPI_HOST=127.0.0.1
GOAPI_PORT=3006
GOAPI_DOMAIN=http://localhost
GOAPI_TITLE=NUBO
GOAPI_VERSION=1.2.12

GOAPI_PROFILE_SIZE=256
GOAPI_CONTENT_INSERT_SIZE=640
GOAPI_THUMBNAIL_SIZE=512
GOAPI_FULL_SIZE=2048
GOAPI_FILE_SIZE_LIMIT=104857600
# 파일시스템의 업로드 루트. 기존 소스 설치는 ./upload, prebuilt 기본값은 /var/lib/nubo/upload 권장
NUBO_UPLOAD_DIR=./upload

# JWT 설정
JWT_SECRET_KEY=#jwtsecret#
SYNC_SECRET_KEY=#syncsecret#
JWT_ACCESS_HOURS=1
JWT_REFRESH_DAYS=30

# 데이터베이스 세팅 (DB_UNIX_SOCKET 경로를 모를 경우 공란 유지)
DB_HOST=#dbhost#
DB_USER=#dbuser#
DB_PASS=#dbpass#
DB_NAME=#dbname#
DB_TABLE_PREFIX=#dbprefix#
DB_PORT=#dbport#
DB_UNIX_SOCKET=#dbsock#
DB_MAX_IDLE=#dbmaxidle#
DB_MAX_OPEN=#dbmaxopen#

# 관리자 아이디(이메일) 및 비밀번호
ADMIN_ID=#adminid#
ADMIN_PW=#adminpw#

# NUXT 런타임 설정 (위 GOAPI/JWT 값과 함께 변경하며 ${...} 변수 참조를 사용하지 않습니다)
NITRO_HOST=127.0.0.1
NITRO_PORT=3000
NUXT_API_BASE_INTERNAL=http://127.0.0.1:3006/goapi
NUXT_PUBLIC_GOAPI_BASE=goapi
NUXT_PUBLIC_VERSION=1.2.12
NUXT_PUBLIC_DOMAIN=http://localhost
NUXT_PUBLIC_TITLE=NUBO
NUXT_PUBLIC_PROFILE_SIZE=256
NUXT_PUBLIC_CONTENT_INSERT_SIZE=640
NUXT_PUBLIC_THUMBNAIL_SIZE=512
NUXT_PUBLIC_FULL_SIZE=2048
NUXT_PUBLIC_FILE_SIZE_LIMIT=104857600
NUXT_PUBLIC_ACCESS_HOURS=1
NUXT_PUBLIC_REFRESH_DAYS=30
NUXT_PUBLIC_ADMIN_ID=#adminid#

# Resend로 메일 발송에 필요한 API Key (없으면 이메일 기능 비활성화)
# 주의) localhost 에서는 동작하지 않으며, 실제 도메인 인증을 받은 서버에서만 동작합니다
# 무료 티어 안내: https://resend.com/pricing
RESEND_API_KEY=
# 비워두면 GOAPI_DOMAIN의 호스트를 이용해 noreply@도메인으로 발송합니다
RESEND_FROM_EMAIL=
# 비워두면 GOAPI_TITLE을 발신자 이름으로 사용합니다
RESEND_FROM_NAME=
# 메일에 답장했을 때 받을 주소 (선택 사항, Gmail 등 외부 주소 가능)
RESEND_REPLY_TO_EMAIL=

# 신규 가입 정책: verified_email(기본) | invite_only | disabled
# invite_only 초대는 관리자 > 사용자 관리에서 발급합니다
SIGNUP_MODE=verified_email

# 구글 OAuth 클라이언트 (없다면 공란 유지)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_SECRET=

# 네이버 OAuth 클라이언트 (없다면 공란 유지)
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_SECRET=

# 카카오 OAuth 클라이언트 (없다면 공란 유지)
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_SECRET=

# OpenAI API Key (없다면 공란 유지, 키만 설정해도 기능이 활성화되지는 않음)
OPENAI_API_KEY=

# 업로드 이미지 설명 생성 (유료 API 호출, 명시적으로 활성화해야 함)
OPENAI_IMAGE_DESCRIPTION_ENABLED=false
OPENAI_IMAGE_DESCRIPTION_MODEL=gpt-5.6-luna
OPENAI_IMAGE_DESCRIPTION_MAX_PER_POST=3
OPENAI_IMAGE_DESCRIPTION_CONCURRENCY=1
