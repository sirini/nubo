{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nubo.sirini.net/contracts/api-response-v1.schema.json",
  "title": "NUBO API response envelope v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "error", "code", "result"],
      "properties": {
        "success": { "const": true },
        "error": { "const": "" },
        "code": { "const": 0 },
        "result": {}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "error", "code", "result"],
      "properties": {
        "success": { "const": false },
        "error": { "type": "string", "minLength": 1 },
        "code": { "type": "integer", "minimum": 1, "maximum": 12 },
        "result": { "type": "null" }
      }
    }
  ]
}
